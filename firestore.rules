rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // Games Collection - Online multiplayer games
    // ============================================
    match /games/{gameId} {
      // Anyone can read public game data
      allow read: if true;
      
      // Only participants can write/update their game
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (resource.data.whitePlayerId == request.auth.uid ||
         resource.data.blackPlayerId == request.auth.uid ||
         isAdmin(request.auth.uid));
    }
    
    // Moves subcollection - Individual moves in a game
    match /games/{gameId}/moves/{moveId} {
      allow read: if true;
      
      // Only Cloud Functions can write moves (via recordMove)
      allow create, update, delete: if false;
    }
    
    // ============================================
    // Matchmaking Queue
    // ============================================
    match /matchmaking_queue/{queueId} {
      // Players can read their own queue entry
      allow read: if request.auth != null &&
        resource.data.playerId == request.auth.uid;
      
      // Players can create their own queue entry
      allow create: if request.auth != null &&
        request.resource.data.playerId == request.auth.uid &&
        validateQueueEntry(request.resource.data);
      
      // Players can delete their own entry
      allow delete: if request.auth != null &&
        resource.data.playerId == request.auth.uid;
      
      // Only Cloud Functions can update (for matching)
      allow update: if false;
    }
    
    // ============================================
    // User Presence
    // ============================================
    match /presence/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
    }
    
    // ============================================
    // User Statistics (read-only)
    // ============================================
    match /users/{userId}/statistics/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions write stats
    }
    
    // ============================================
    // Helper functions
    // ============================================
    
    function isAdmin(uid) {
      return get(/databases/$(database)/documents/admins/$(uid)).data.isAdmin == true;
    }
    
    function validateQueueEntry(data) {
      return data.playerId != null &&
             data.playerName != null &&
             data.currentRating > 0 &&
             data.ratingRange != null &&
             data.ratingRange.min > 0 &&
             data.ratingRange.max > 0 &&
             data.timeControlType in ['3min', '5min', '10min'] &&
             data.queuedAt != null &&
             data.timeoutAt != null &&
             data.priority >= 0 &&
             data.status in ['waiting', 'matched', 'expired'] &&
             data.color in ['white', 'black', 'random'];
    }
    
    function isValidMove(from, to) {
      return from != null &&
             to != null &&
             from != to &&
             from.size() == 2 &&
             to.size() == 2;
    }
  }
}
