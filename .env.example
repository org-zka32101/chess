# RevenueCat Configuration
# Get your API key from: https://dashboard.revenuecat.com/
# This is the Public SDK Key for your app
REVENUEAT_API_KEY=your_revenueat_public_sdk_key_here

# Firebase Configuration (if needed for local Firebase emulator)
# FIREBASE_EMULATOR_HOST=localhost:8080

# App Environment
APP_ENV=development

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_REVENUE_CAT=true
